  "whatsapp_greeting": "\u05e9\u05dc\u05d5\u05dd, \u05d0\u05e0\u05d9 \u05e1\u05d5\u05db\u05df \u05e0\u05d9\u05d4\u05d5\u05dc \u05db\u05dc\u05d9 \u05d4-AI \u05e9\u05dc\u05da. \u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05dc\u05de\u05e6\u05d5\u05d0 \u05db\u05dc\u05d9\u05dd, \u05dc\u05d0\u05e8\u05d2\u05df \u05d0\u05ea \u05d4\u05de\u05d0\u05d2\u05e8, \u05dc\u05d9\u05e6\u05d5\u05e8 \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d5\u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea, \u05d5\u05dc\u05d4\u05e9\u05d5\u05d5\u05ea \u05d1\u05d9\u05df \u05db\u05dc\u05d9\u05dd \u05e9\u05db\u05d1\u05e8 \u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05e6\u05dc\u05da.",
  "name": "tool_advisor"
