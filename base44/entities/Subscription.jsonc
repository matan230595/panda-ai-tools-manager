{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "toolName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05dc\u05d9"
    },
    "toolId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05dc\u05d9"
    },
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea"
    },
    "username": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "password": {
      "type": "string",
      "description": "\u05e1\u05d9\u05e1\u05de\u05d4 (\u05de\u05d5\u05e6\u05e4\u05e0\u05ea)"
    },
    "subscriptionType": {
      "type": "string",
      "enum": [
        "\u05d7\u05d9\u05e0\u05de\u05d9",
        "\u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd",
        "\u05d2\u05d5\u05dc\u05d3"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e0\u05d5\u05d9"
    },
    "priceMonthly": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "renewalDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d7\u05d9\u05d3\u05d5\u05e9"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "\u05de\u05e0\u05d5\u05d9 \u05e4\u05e2\u05d9\u05dc"
    },
    "autoRenewal": {
      "type": "boolean",
      "default": true,
      "description": "\u05d7\u05d9\u05d3\u05d5\u05e9 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9"
    },
    "paymentMethod": {
      "type": "string",
      "description": "\u05d0\u05de\u05e6\u05e2\u05d9 \u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "apiKey": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 API (\u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    }
  },
  "required": [
    "toolName",
    "toolId",
    "subscriptionType"
  ]
}