{
  "name": "ToolLearningPlan",
  "type": "object",
  "properties": {
    "toolId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05dc\u05d9"
    },
    "toolName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05dc\u05d9"
    },
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05dc\u05de\u05d9\u05d3\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "isCompleted": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "\u05e9\u05dc\u05d1\u05d9 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4"
    },
    "progress": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "targetDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3 \u05db\u05dc\u05dc\u05d9"
    }
  },
  "required": [
    "toolId",
    "toolName",
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}