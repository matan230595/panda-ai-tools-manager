{
  "name": "ApiKeyVault",
  "type": "object",
  "properties": {
    "toolId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05dc\u05d9 \u05d4\u05de\u05e9\u05d5\u05d9\u05da"
    },
    "toolName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05dc\u05d9"
    },
    "provider": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e4\u05e7 \u05d4-API"
    },
    "label": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8/\u05ea\u05d5\u05d5\u05d9\u05ea \u05dc\u05de\u05e4\u05ea\u05d7"
    },
    "apiKey": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d4-API (\u05de\u05d5\u05e6\u05e4\u05df)"
    },
    "expiresAt": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e4\u05d5\u05d2\u05d4"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "\u05de\u05e4\u05ea\u05d7 \u05e4\u05e2\u05d9\u05dc"
    },
    "lastVerified": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e7\u05e4\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "unverified"
      ],
      "default": "unverified",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e7\u05e4\u05d5\u05ea"
    }
  },
  "required": [
    "toolId",
    "provider",
    "apiKey"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}